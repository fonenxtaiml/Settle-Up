<?xml version="1.0" encoding="utf-8"?>
<!-- Launch window (API 26 to 30, and behind the Android 12+ splash): the
     tether on stone, so a cold start blends into the first Flutter frame.
     Colours flip with values-night. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/launch_background" />
    <item
        android:width="108dp"
        android:height="108dp"
        android:gravity="center"
        android:drawable="@drawable/ic_launch_mark" />
</layer-list>
