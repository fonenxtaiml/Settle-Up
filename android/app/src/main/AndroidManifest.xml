<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- SPEC 9.1. LAN/hotspot sync: TCP server + mDNS (multicast lock). -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />
    <!-- QR scanning (invite and connect codes) -->
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- Bluetooth, API 31+ ("Nearby devices" group) -->
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN"
        android:usesPermissionFlags="neverForLocation"
        tools:targetApi="s" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADVERTISE" />
    <!-- Wi-Fi nearby (Nearby Connections, LocalOnlyHotspot), API 33+ -->
    <uses-permission android:name="android.permission.NEARBY_WIFI_DEVICES"
        android:usesPermissionFlags="neverForLocation"
        tools:targetApi="tiramisu" />
    <!-- Legacy Bluetooth, API <= 30. tools:node="replace" keeps the caps when
         plugin manifests (nearby_connections) declare these uncapped. -->
    <uses-permission android:name="android.permission.BLUETOOTH"
        android:maxSdkVersion="30"
        tools:node="replace" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN"
        android:maxSdkVersion="30"
        tools:node="replace" />
    <!-- Location: BLE scan on <= 30, Nearby Connections and LocalOnlyHotspot
         on <= 32 -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION"
        android:maxSdkVersion="32"
        tools:node="replace" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION"
        android:maxSdkVersion="32"
        tools:node="replace" />
    <uses-feature android:name="android.hardware.bluetooth_le" android:required="false" />
    <uses-feature android:name="android.hardware.bluetooth" android:required="false" />
    <uses-feature android:name="android.hardware.wifi" android:required="false" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.camera.autofocus" android:required="false" />
    <!-- Add ONLY when targetSdk >= 37, and request it with the Nearby devices
         group:
    <uses-permission android:name="android.permission.ACCESS_LOCAL_NETWORK" /> -->

    <!-- No backup and no device-to-device transfer: a restored or copied op
         log with a cloned device id would fork the per-device counters
         (SPEC 7.4). allowBackup and fullBackupContent cover API <= 30;
         dataExtractionRules covers API 31+, where allowBackup="false" no
         longer stops device-to-device transfer. -->
    <application
        android:label="Settle Up"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        tools:replace="android:allowBackup">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
            <!-- Invite and connect links: settleup://join?... and
                 settleup://sync?... (SPEC 8.6) -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="settleup" android:host="join" />
                <data android:scheme="settleup" android:host="sync" />
            </intent-filter>
        </activity>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
        <!-- No usage metrics to Google (SECURITY-R1-13, docs/PRIVACY.md).
             mobile_scanner bundles ML Kit barcode scanning, which reports
             API usage and performance events through Firebase data
             transport ("cct" backend, firebaselogging-pa.googleapis.com).
             Removing the backend from the discovery service leaves the
             runtime with no backend: every event is dropped before it is
             stored or scheduled (DefaultScheduler: "Transport backend 'cct'
             is not registered"). Barcode decoding is on-device and does not
             use this path. This element declares nothing of ours; it only
             strips that meta-data from the merged manifest. -->
        <service
            android:name="com.google.android.datatransport.runtime.backends.TransportBackendDiscovery"
            tools:node="merge">
            <meta-data
                android:name="backend:com.google.android.datatransport.cct.CctBackendFactory"
                tools:node="remove" />
        </service>
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
